// `use` copies the named fns plus everything they reach; lists stay explicit.
program {
    use prelude::{quarter_of};
    fn f(x: f64) -> f64 { return quarter_of(ext sin(x)); }
    unit u {
        main f;
        helpers [quarter_of, halve];
        consts [half, quarter];
    }
    entry u @dims(1, 1, 1) @origin_scale(1, 1, 1) @position_scale(1, 1, 1);
}
